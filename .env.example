# EC2 등 배포 서버에서: cp .env.example .env 후 값 입력
# docker compose는 같은 디렉터리의 .env를 백엔드 컨테이너에 전달합니다.

# --- DB (필수로 쓸 때) SQLAlchemy URL. 예: Supabase/Postgres
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# --- CORS (필수: 브라우저에서 접속하는 프론트 주소) 쉼표로 구분, 공백 없이
# 로컬 개발 + EC2 퍼블릭 IP(또는 도메인) 예:
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_PUBLIC_IP
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- S3 (선택)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# S3_BUCKET=
# S3_PREFIX=inventory

# --- 기타 (선택)
# DB_ECHO=false
